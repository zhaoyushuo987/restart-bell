{
  "name": "restart-bell",
  "version": "0.4.0",
  "description": "重启铃 restart-bell：给 DeepSeek Harness 的 Web GUI 顶部加一个可拖动的 ⟳ 小按钮，点一下弹小列表——「重启」强杀后原样拉起（插件/配置改动立即生效），「关闭」只关不拉。全程无命令行黑窗；助手先杀主进程再清场，拉起后核对进程真的活着，不行就用 explorer 兜底",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "restart",
    "quit",
    "relaunch",
    "one-click",
    "no-console-window",
    "wscript",
    "vbs",
    "restart-bell"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build:helper": "node scripts/embed-helper.mjs",
    "selftest": "node scripts/selftest-helper.mjs"
  },
  "license": "MIT",
  "author": "zhaoyushuo987",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhaoyushuo987/restart-bell.git"
  },
  "homepage": "https://github.com/zhaoyushuo987/restart-bell#readme",
  "bugs": {
    "url": "https://github.com/zhaoyushuo987/restart-bell/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}